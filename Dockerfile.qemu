FROM --platform=linux/arm64 debian:trixie

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PWNDBG_NO_AUTOUPDATE=1

# arm64-хост: gdb-multiarch (умеет x86-64) + qemu-user (эмуляция) + тулинг
RUN apt-get update && apt-get install -y --no-install-recommends \
        gdb-multiarch git python3 python3-pip python3-venv \
        qemu-user file less vim-tiny xxd procps \
        socat netcat-openbsd ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# x86-64 libc: чтобы под qemu запускались ДИНАМИЧЕСКИЕ ELF
RUN dpkg --add-architecture amd64 \
    && apt-get update \
    && apt-get install -y --no-install-recommends libc6:amd64 libstdc++6:amd64 \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages --no-cache-dir pwntools

# pwndbg из upstream (qemu 10 => pwndbg с qemu-user работает)
RUN git clone --depth 1 https://github.com/pwndbg/pwndbg /opt/pwndbg \
    && cd /opt/pwndbg && ./setup.sh

COPY qgdb /usr/local/bin/qgdb
RUN chmod +x /usr/local/bin/qgdb

WORKDIR /work
CMD ["/bin/bash"]
